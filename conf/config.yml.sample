# 首次启动导入 SQLite；之后以 /admin 后台为准，重启服务生效。
server:
  listen: ":8001"
  # 设备调用 /worktime/summary、/ai/usage 用的固定 Bearer Token（设备后台填同一个值）
  token: "change-me"
  # /admin 管理后台登录账号密码
  username: "admin"
  password: "admin"    # 部署后请立即在 /admin 里改掉

log:
  level: "info"   # debug | info | warn | error；可被环境变量 DESKWONG_LOG_LEVEL 覆盖
  format: "text"  # text | json；可被环境变量 DESKWONG_LOG_FORMAT 覆盖

worktime:
  expected_daily_hours: 8
  token: ""
  pingcode:
    base_url: ""
    username: ""
    password: ""
    timeout_sec: 20
  mysql:
    dsn: ""
    employee_no: ""
    query: ""
    timeout_sec: 10
