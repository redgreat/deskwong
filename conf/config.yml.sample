# 首次启动导入 SQLite；后续通过 /admin 修改，重启服务生效。
server:
  listen: ":8001"
  token: "change-me"
  tokens: []
  allow_cidrs: []

worktime:
  expected_daily_hours: 8
  token: ""
  mysql:
    dsn: ""
    employee_no: ""
    query_file: "/app/conf/worktime.sql"
    query: ""
    timeout_sec: 10

log:
  level: "info"
  format: "text"
